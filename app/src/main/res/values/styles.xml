<resources>
    <style name="SupproxyTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#5145AF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#F7F7F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="ProtocolDropdownAnimation">
        <item name="android:windowEnterAnimation">@anim/protocol_dropdown_enter</item>
        <item name="android:windowExitAnimation">@anim/protocol_dropdown_exit</item>
    </style>
</resources>
